{{!
    @template local_wb_dashboard/toplist

    Renders a ranked top-N list (rank, label, progress bar, value) and loads
    its rows via the web service. All row slots are rendered server-side with
    their rank numbers prefilled and stay hidden until the JS fills them —
    the JS never builds markup, it only sets text, widths and visibility.

    The wrapper id is deterministic and constant so it can be targeted in CSS.

    Context variables required for this template:
    * domid - Deterministic, constant DOM id for the list wrapper.
    * title - Optional heading ('' = hidden).
    * rows - One {rank} entry per row slot (top N).
    * pageid - Page identifier for shared filter state.
    * consumes - JSON array of filter keys this list reacts to.
    * wsargs - JSON object of web-service arguments (source, params, ...).
    * palettename - Active palette name; added as a wb-palette-NAME scope class.
    * hasdetails - Whether rows carry a "see details" drill-down button.
    * detailsname - Name of the detail template the modal renders.
    * contextid - Context id the detail fragment is loaded for.
    * hasbars - Whether rows render the progress bar (bars=0 hides it).

    Example context (json):
    {
        "domid": "local-dashboard-toplist-ab12cd34ef56",
        "title": "Top courses",
        "rows": [{"rank": 1}, {"rank": 2}, {"rank": 3}],
        "pageid": "default",
        "consumes": "[]",
        "wsargs": "{}",
        "palettename": "standard",
        "hasdetails": true,
        "detailsname": "coursedetail",
        "contextid": 1,
        "hasbars": true
    }
}}
<div class="local-dashboard-toplist wb-palette-{{palettename}}" id="{{domid}}"
     data-region="toplist-wrapper"
     data-pageid="{{pageid}}"
     data-consumes="{{consumes}}"
     data-wsargs="{{wsargs}}"
     {{#hasdetails}}data-details="{{detailsname}}" data-contextid="{{contextid}}"{{/hasdetails}}
     aria-busy="true">
    {{#title}}
    <div class="local-dashboard-toplist-title" id="{{domid}}-title">{{title}}</div>
    {{/title}}
    <div class="local-dashboard-toplist-skeleton" aria-hidden="true"></div>
    <ol class="local-dashboard-toplist-rows">
        {{#rows}}
        <li class="local-dashboard-toplist-row" data-region="toplist-row" style="display: none;">
            <span class="local-dashboard-toplist-rank" aria-hidden="true">{{rank}}</span>
            <span class="local-dashboard-toplist-body">
                <span class="local-dashboard-toplist-label" data-region="toplist-label"></span>
                {{#hasbars}}
                <span class="local-dashboard-toplist-bar">
                    <span class="local-dashboard-toplist-bar-fill" data-region="toplist-bar" style="width: 0%;"></span>
                </span>
                {{/hasbars}}
            </span>
            <span class="local-dashboard-toplist-value" data-region="toplist-value"></span>
            {{#hasdetails}}
            <button type="button" class="local-dashboard-toplist-detail btn btn-link p-0"
                    data-action="wb-dashboard-detail" style="display: none;">
                {{#str}}toplist:seedetails, local_wb_dashboard{{/str}}
            </button>
            {{/hasdetails}}
        </li>
        {{/rows}}
    </ol>
    <div class="local-dashboard-toplist-empty" data-region="toplist-empty" style="display: none;">
        {{#str}}toplist:nodata, local_wb_dashboard{{/str}}
    </div>
</div>

{{#js}}
require(['local_wb_dashboard/toplist'], function(toplist) {
    toplist.init({{#quote}}{{domid}}{{/quote}});
});
{{#hasdetails}}
require(['local_wb_dashboard/detail_modal'], function(detailModal) {
    detailModal.init({{#quote}}{{domid}}{{/quote}});
});
{{/hasdetails}}
{{/js}}
