{{!
    @template local_wb_dashboard/filterreset

    Renders a button that clears every page filter via the filterbus.

    Context variables required for this template:
    * elementid - Unique DOM id for the button.
    * label - Button label.

    Example context (json):
    {
        "elementid": "local-dashboard-filterreset-1",
        "label": "Reset filters"
    }
}}
<button type="button" id="{{elementid}}"
    class="btn btn-secondary local-dashboard-filterreset"
    data-region="filter-reset">{{label}}</button>

{{#js}}
require(['local_wb_dashboard/filterreset'], function(filterreset) {
    filterreset.init({{#quote}}{{elementid}}{{/quote}});
});
{{/js}}
